# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=hse_provider
MONGODB_COLLECTION=leads

# Demo only: validates forms but does not persist or send submitted data
DEMO_MODE=false

# Production site and measurement
NEXT_PUBLIC_SITE_URL=https://landing.1hse.vn
NEXT_PUBLIC_GA_ID=
GOOGLE_SEARCH_CONSOLE_VERIFICATION=-7b6qYgG7qZbKEAr4qnT81GNxmrKlqFl-Lx1M7nD040

# Google Sheets (service-account JSON on one line)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Leads!A:Z
GOOGLE_SERVICE_ACCOUNT_JSON={}

# SMTP (Gmail demo; use an App Password, never the normal account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEAD_NOTIFICATION_EMAIL=haithy123@gmail.com

# Lead workflow: Vercel Cron runs daily at 08:00 Vietnam time (01:00 UTC).
# Use a long random value in production. Vercel forwards it only to the cron route.
CRON_SECRET=
LEAD_REMINDER_AFTER_HOURS=24
LEAD_REMINDER_REPEAT_HOURS=24
